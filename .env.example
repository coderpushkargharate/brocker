NEXT_PUBLIC_SITE_URL=https://your-domain.com
AUTH_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=pushkargharate3011@gmail.com
ADMIN_PASSWORD=change-me
GOOGLE_SITE_VERIFICATION=
# Postgres connection (Vercel/Neon adds this automatically; Supabase also works)
DATABASE_URL=
# Vercel Blob token for photo/document uploads (added automatically when Blob is connected)
BLOB_READ_WRITE_TOKEN=
# Optional: where the JSON database and uploads are stored when DATABASE_URL is empty (defaults to ./data)
DATA_DIR=
# MongoDB connection (Atlas). When set, it is used instead of Postgres / the JSON file
MONGODB_URI=
# Optional: database name (defaults to "agriland")
MONGODB_DB=agriland
