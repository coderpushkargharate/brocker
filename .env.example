# ---------- required in production ----------
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# random string, at least 32 characters (e.g. `openssl rand -base64 48`). Logins are refused in production without it.
AUTH_SECRET=
# admin account created when a NEW database is first set up (empty password = random, unusable password)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ---------- database / storage (pick one database) ----------
# MongoDB Atlas (takes priority over DATABASE_URL and the local JSON file)
MONGODB_URI=
MONGODB_DB=agriland
# Postgres connection (Vercel/Neon adds this automatically; Supabase also works)
DATABASE_URL=
# Vercel Blob token for photo/document uploads (added automatically when Blob is connected)
BLOB_READ_WRITE_TOKEN=
# Optional: where the JSON database and uploads are stored when no database URL is set (defaults to ./data)
DATA_DIR=
# Load sample lands/users/reviews into a NEW database. Defaults to true in development, false in production.
# Never enable on the live site: sample listings and reviews are not real.
SEED_DEMO_DATA=

# ---------- business details (shown on the site, legal pages and structured data) ----------
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_CITY=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_RERA_AGENT_NO=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
# social profile URLs; icons are only shown for the ones you set
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# ---------- search & ads (all optional; nothing loads until a visitor consents) ----------
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
